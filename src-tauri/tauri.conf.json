{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeVoice",
  "version": "0.1.0",
  "identifier": "com.jorgebraga.codevoice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CodeVoice",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      },
      {
        "label": "recorder",
        "url": "index.html?window=recorder",
        "title": "Gravando — CodeVoice",
        "width": 320,
        "height": 132,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
